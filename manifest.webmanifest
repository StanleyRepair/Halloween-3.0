{
  "id": "https://stanleyrepair.github.io/Halloween-3.0/",
  "name": "Halloween 3.0",
  "short_name": "Halloween 3.0",
  "description": "Halloween 3.0 — aplikacja imprezy przebieranej.",
  "lang": "pl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#090706",
  "theme_color": "#090706",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://stanleyrepair.github.io/Halloween-3.0/manifest.webmanifest",
      "id": "https://stanleyrepair.github.io/Halloween-3.0/"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+halloween",
      "url": "./?h3protocol=%s"
    }
  ],
  "icons": [
    {"src":"icons/halloween-icon-192.png?v=7","sizes":"192x192","type":"image/png","purpose":"any"},
    {"src":"icons/halloween-icon-512.png?v=7","sizes":"512x512","type":"image/png","purpose":"any"},
    {"src":"icons/halloween-icon-maskable-circle-512.png?v=7","sizes":"512x512","type":"image/png","purpose":"maskable"},
    {"src":"icons/notification-badge.svg?v=1","sizes":"any","type":"image/svg+xml","purpose":"monochrome"}
  ]
}